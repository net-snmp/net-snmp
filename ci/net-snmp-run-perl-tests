#!/bin/sh

set -eu

preload_libasan() {
    cc=$(sed -n "s/^CC='//p" config.status | sed "s/'$//")
    preload=""
    if nm ./snmplib/.libs/libnetsnmp.so 2>/dev/null | grep -q __asan; then
	libasan_path=$(${cc} -print-file-name=libasan.so 2>/dev/null)
	if [ -n "$libasan_path" ] && [ -f "$libasan_path" ]; then
            preload="$libasan_path"
	fi
    fi
    if nm ./snmplib/.libs/libnetsnmp.so 2>/dev/null | grep -q __ubsan; then
	libubsan_path=$(${cc} -print-file-name=libubsan.so 2>/dev/null)
	if [ -n "$libubsan_path" ] && [ -f "$libubsan_path" ]; then
            preload="${preload:+$preload:}$libubsan_path"
	fi
    fi
    if [ -n "$preload" ]; then
        export ASAN_OPTIONS=detect_leaks=0 LD_PRELOAD="$preload"
    fi
}

lib_dirs() {
    find . \( -name '*.dylib' -o -name '*.so' \) |
	grep -v NetSNMP/agent/default_store |
	sed 's,^\./,'"$PWD/"',;s,/[^/]*$,,' |
	sort -u |
	tr '\n' :
}

export NOAUTODEPS=1
make -s perlmakefiles
(
    cd perl
    make -s
)
preload_libasan
# DYLD_LIBRARY_PATH and LD_LIBRARY_PATH must be set before "cd perl" happens.
case "$(uname)" in
    Darwin)
        DYLD_LIBRARY_PATH="$(lib_dirs)"
        export DYLD_LIBRARY_PATH
        ;;
    *)
        LD_LIBRARY_PATH="$(lib_dirs)"
        export LD_LIBRARY_PATH
        ;;
esac
cd perl
rc=0
make test || rc=$?

if [ $rc -eq 0 ]; then
    exit 0
fi

echo "Perl tests failed (exit code $rc). Dumping log files..."
find . -name '*.log' -o -name '*.stderr' |
    while read -r logfile; do
	[ -s "$logfile" ] || continue
        echo "======================================================================"
        echo "FILE: $logfile"
        echo "======================================================================"
        cat "$logfile"
        echo "======================================================================"
    done

exit $rc

